# UptimeDesk backend production environment template
# Copy these names into Render environment variables. Do not commit real values.

SPRING_PROFILES_ACTIVE=prod

# Recommended for Render/Supabase free-tier style deployments: Supabase Session Pooler.
# Format: jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password

# Supabase Auth JWT validation settings.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_JWK_SET_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
